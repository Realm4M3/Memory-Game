<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <gradient
                android:startColor="#87CEEB"
                android:endColor="#E0F7FF"
                android:angle="90" />
        </shape>
    </item>

    <item
        android:top="60dp"
        android:left="30dp">
        <shape android:shape="oval">
            <size android:width="120dp" android:height="60dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>

    <item
        android:top="90dp"
        android:left="120dp">
        <shape android:shape="oval">
            <size android:width="160dp" android:height="70dp" />
            <solid android:color="#F5FFFFFF" />
        </shape>
    </item>

    <item
        android:top="180dp"
        android:left="220dp">
        <shape android:shape="oval">
            <size android:width="140dp" android:height="65dp" />
            <solid android:color="#F2FFFFFF" />
        </shape>
    </item>

</layer-list>